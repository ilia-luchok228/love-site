<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ЖЕНЯ ❤️</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background-color: #ffffff;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: 'Arial Black', 'Impact', sans-serif;
            overflow: hidden;
        }
        .neon-text {
            font-size: 12vw;
            font-weight: 900;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: #fff;
            text-shadow:
                0 0 7px #ff4da6,
                0 0 10px #ff4da6,
                0 0 21px #ff4da6,
                0 0 42px #ff1a8c,
                0 0 82px #ff1a8c,
                0 0 92px #e60073,
                0 0 102px #cc005f,
                0 0 151px #b3004d;
            animation: flicker 1.5s infinite alternate;
            text-align: center;
            padding: 20px;
            user-select: none;
        }
        @keyframes flicker {
            0% {
                text-shadow: 0 0 7px #ff4da6, 0 0 10px #ff4da6, 0 0 21px #ff4da6, 0 0 42px #ff1a8c, 0 0 82px #ff1a8c, 0 0 92px #e60073, 0 0 102px #cc005f, 0 0 151px #b3004d;
                transform: scale(1);
            }
            50% {
                text-shadow: 0 0 10px #ff66b2, 0 0 20px #ff66b2, 0 0 40px #ff3399, 0 0 80px #ff1a8c, 0 0 120px #e60073, 0 0 150px #cc005f, 0 0 200px #b3004d, 0 0 250px #990040;
                transform: scale(1.02);
            }
            100% {
                text-shadow: 0 0 5px #ff4da6, 0 0 8px #ff4da6, 0 0 18px #ff4da6, 0 0 38px #ff1a8c, 0 0 78px #ff1a8c, 0 0 88px #e60073, 0 0 98px #cc005f, 0 0 145px #b3004d;
                transform: scale(0.98);
            }
        }
        .heart {
            position: fixed;
            bottom: 30px;
            right: 30px;
            font-size: 40px;
            animation: heartbeat 1s infinite;
            color: #ff1a8c;
            text-shadow: 0 0 20px #ff1a8c;
        }
        @keyframes heartbeat {
            0% { transform: scale(1); }
            30% { transform: scale(1.3); }
            50% { transform: scale(1); }
            70% { transform: scale(1.2); }
            100% { transform: scale(1); }
        }
    </style>
</head>
<body>
    <div class="neon-text">ЖЕНЯ Я ТЕБЯ ЛЮБЛЮ</div>
    <div class="heart">❤️</div>
</body>
</html>